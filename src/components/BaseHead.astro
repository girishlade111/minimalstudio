---
import "../styles/global.css";
import { AstroSeo } from "@lexingtonthemes/seo";

const base = import.meta.env.BASE_URL;
const siteUrl = new URL(base, "https://girishlade111.github.io").href;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Minimal Studio",
  url: siteUrl,
  description: "A minimal studio landing page built with Astro and Tailwind CSS.",
};
---

<AstroSeo
  title="Minimal Studio — Design and front-end studio"
  description="A minimal studio landing page built with Astro and Tailwind CSS."
  canonical={siteUrl}
  openGraph={{
    url: siteUrl,
    title: "Minimal Studio — Design and front-end studio",
    description: "A minimal studio landing page built with Astro and Tailwind CSS.",
    site_name: "Minimal Studio",
    type: "website",
    locale: "en_US",
  }}
  twitter={{
    handle: "@yourhandle",
    site: "@yoursite",
    cardType: "summary_large_image",
  }}
/>

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="author" content="Your Name or Company Name" />
<meta name="theme-color" content="#ffffff" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />

<!-- Favicons -->
<link rel="icon" href={`${base}favicon.ico`} sizes="any" />
<link rel="icon" href={`${base}icon.svg`} type="image/svg+xml" />
<link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
<link rel="manifest" href={`${base}manifest.webmanifest`} />
<link rel="shortcut icon" href={`${base}favicon.ico`} type="image/x-icon" />
<link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16x16.png`} />
<link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`} />
<link rel="icon" type="image/png" sizes="48x48" href={`${base}favicon-48x48.png`} />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap"
  rel="stylesheet"
/>
<link
  href="https://cdn.jsdelivr.net/npm/keen-slider@6.8.6/keen-slider.min.css"
  rel="stylesheet"
/>
